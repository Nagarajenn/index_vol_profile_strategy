# Local tool settings (machine/session-specific, not shared project config)
.claude/

# Secrets
.env
backend/.env

# Python
venv/
backend/venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.mypy_cache/
*.egg

# Node / frontend
frontend/node_modules/
frontend/dist/
