# Copy this file to .env and fill in your own values. Never commit .env.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Create the database + role yourself first (pgAdmin or psql), then fill this in.
# Example: postgresql://vol_profile_user:yourpassword@localhost:5432/vol_profile
# If your password contains special characters (@, :, /, etc.) they must be
# percent-encoded (@ -> %40) or the connection string will fail to parse.
DATABASE_URL=

# Optional: schema to use within that database if not the default "public".
DB_SCHEMA=public
